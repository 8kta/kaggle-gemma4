# All external downloads (competition dataset via kagglehub, pulled Kaggle
# notebooks/kernels, etc.) — large, regenerable, never committed
downloads/

# Native swegemma eval output — regenerated locally, not tracked
results/

# Per-run trace/log/patch artifacts are large; keep only experiments/CHANGELOG.md
# and any explicit per-run summary.json you choose to commit
experiments/*/
!experiments/CHANGELOG.md

# MLflow local file-backed tracking store (if used outside the localhost:5001 server)
mlruns/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Env/secrets — must never end up in submission/ or be committed
.env
*.env

# LoRA adapter weights are large binary artifacts — track intentionally, not
# by default. Leading **/ needed: without it, this pattern is anchored to the
# repo root and silently does NOT match submission/adapters/ (verified empty
# match with a bare `adapters/**/*.safetensors` — the real submission path
# wasn't covered at all).
**/adapters/**/*.safetensors

# OS cruft
.DS_Store
